{
  "manifest_version": 3,
  "name": "Warehouse Tote Lookup Assistant",
  "version": "0.1.0",
  "description": "Read-only helper that merges tote/product data from Inventory, Pandash, and QT into a single view. Does not modify inventory and does not submit receive/stow/cancel actions.",
  "permissions": ["tabs", "sidePanel", "offscreen", "storage", "unlimitedStorage", "clipboardWrite", "alarms", "notifications"],
  "host_permissions": [
    "https://qifcr.eu.aftx.amazonoperations.app/*",
    "https://pandash.eu.aftx.amazonoperations.app/*",
    "https://qt.eu.aftx.amazonoperations.app/*",
    "https://atlas.na.aftx.amazonoperations.app/*",
    "https://aft-poirot-website.eu.aftx.amazonoperations.app/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://qt.eu.aftx.amazonoperations.app/*"],
      "js": ["content-scripts/qtContentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Warehouse Tote Lookup Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
